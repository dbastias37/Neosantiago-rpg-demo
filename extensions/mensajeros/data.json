  "missions": {
    "guzman-01": {
      "id": "guzman-01",
      "enabled": false,
      "npc": "guzman",
      "name": "Piezas para seguir en pie",
      "type": "delivery",
      "route": "guzman-plaza",
      "portrait": "../../characters/encargos/guzman.webp",
      "issuer": "Guzmán",
      "recipient": "Técnicos de Plaza de Armas",
      "summary": "Transporta 2 rotores y 1 sensor de movimiento desde Los Leones. Los técnicos los necesitan para las torretas que protegen la salida del refugio.",
      "briefing": "Estos dos rotores devuelven el movimiento a las torretas. El sensor les permite detectar lo que se acerca. Llévenlos a los técnicos de Plaza de Armas; ellos se encargan de instalarlos. El viaje es largo. Revisen sus provisiones antes de salir.",
      "cargo": {
        "rotor": 2,
        "motion-sensor": 1
      },
      "issued": {},
      "test_loadout": {
        "food": 3,
        "water": 3,
        "ammo556": 12
      },
      "reward": {
        "base": 40,
        "stealth_bonus": 0
      },
      "dialogues": {
        "success": "Llegaron los dos rotores y el sensor. Con esto podemos recuperar el movimiento y la detección de las torretas. Gracias por traerlos.",
        "issuer_report": "Los técnicos confirmaron la entrega. Buen trabajo. Esas piezas hacían falta."
      }
    },
    "adasme-01": {
      "id": "adasme-01",
      "enabled": false,
      "npc": "adasme",
      "name": "Fuera de contacto",
      "type": "extraction",
      "route": "adasme-oriente",
      "portrait": "../../characters/encargos/adasme.webp",
      "issuer": "Adasme",
      "recipient": "Adasme · Vicuña Mackenna",
      "summary": "Encuentra al operativo incomunicado entre Los Leones y Tobalaba. Lleva provisiones y vuelve con él evitando enfrentamientos.",
      "briefing": "Venían de recuperar municiones y equipo de defensa electrónica. Al entrar por la escotilla notaron que faltaba uno. Su grupo está en otra misión y no puede volver. Busquen en el refugio provisorio que conocemos. Les doy tres bombas de humo y un inhibidor: tiene veinte minutos de batería. Si no puede caminar, habrá que cargarlo. Eviten las peleas; alertar la ruta pondrá en peligro a los siguientes.",
      "cargo": {},
      "issued": {
        "smoke": 3,
        "jammer": 1
      },
      "test_loadout": {
        "food": 3,
        "water": 3,
        "ammo556": 12
      },
      "reward": {
        "base": 40,
        "stealth_bonus": 30
      },
      "dialogues": {
        "stealth": "Volvieron con él y no hubo enfrentamientos. Eso era lo que necesitábamos. Les corresponde la recompensa completa.",
        "combat": "Me alegra que lo hayan traído. Pero los enfrentamientos alertaron el corredor. Habrá más vigilancia en los túneles y afuera. La recompensa será menor, como les advertí.",
        "carried": "Me dijeron que tuvieron que cargarlo. Gracias por no dejarlo ahí."
      }
    }
  },
